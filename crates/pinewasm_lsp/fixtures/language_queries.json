  {
    "name": "shared-htf-pure-helper-fixture",
    "request": {
      "schemaVersion": 1,
      "document": {
        "id": "htf-fixture",
        "version": "fixture-1",
        "source": "//@version=6\nindicator(\"Shared fixture\")\nplot(close)"
      },
      "capability": "analyze"
    },
    "htfPureHelper": {
      "source": "//@version=6\nindicator(\"Confirmed kernel\")\nimport test/Kernel/2 as kernels\nconfirmed() =>\n    estimate = kernels.rationalQuadratic(close, 8, 8, 25)\n    [estimate[1], estimate[1] > estimate[2], estimate[1] < estimate[2]]\n[value, up, down] = request.security(syminfo.tickerid, \"1D\", confirmed(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)\nplot(value)\nplot(up ? 1.0 : 0.0)\nplot(down ? 1.0 : 0.0)\n",
      "library": "//@version=6\nlibrary(\"Kernel\")\nexport rationalQuadratic(series float src, simple int lookback, simple float relativeWeight, simple int startAtBar) =>\n    float weighted = 0.0\n    float total = 0.0\n    size = array.size(array.from(src))\n    for i = 0 to size + startAtBar by 1\n        y = src[i]\n        w = math.pow(1 + (math.pow(i, 2) / (math.pow(lookback, 2) * 2 * relativeWeight)), -relativeWeight)\n        weighted := weighted + y*w\n        total := total + w\n        total\n    estimate = weighted / total\n    estimate\n"
    }
  }
