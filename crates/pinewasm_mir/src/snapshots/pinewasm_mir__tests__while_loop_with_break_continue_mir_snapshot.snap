  v2 = read_user slot0[0]
  v3 = const 10
  v4 = binary `<` v2, v3
  branch v4, bb5, bb6
bb5:
  v5 = read_user slot0[0]
  v6 = const 5
  v7 = binary `==` v5, v6
  branch v7, bb7, bb8
bb6:
  v11 = read_user slot0[0]
  v12 = int_to_float v11
  v13 = const #2196F3
  plot p0, v12
    color Color v13
  return
bb7:
  jump bb6
bb8:
  jump bb9
bb9:
  v8 = read_user slot0[0]
  v9 = const 1
  v10 = binary `+` v8, v9 (int)
