//@version=5
strategy("Crossover With Targets", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, commission_type = strategy.commission.percent, commission_value = 0.05)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
fastLen = input.int(10, "Fast Length", minval = 1)
slowLen = input.int(30, "Slow Length", minval = 1)
takeTicks = input.int(400, "Take Profit Ticks", minval = 1)
stopTicks = input.int(200, "Stop Loss Ticks", minval = 1)
useFilter = input.bool(true, "Use RSI Filter")
rsiLimit = input.float(70.0, "RSI Limit")
allowShorts = input.bool(true, "Allow Shorts")
startYear = input.int(2020, "Start Year")

// ---------------------------------------------------------------------------
// Signals
// ---------------------------------------------------------------------------
fast = ta.sma(close, fastLen)
slow = ta.sma(close, slowLen)
rsi = ta.rsi(close, 14)
inWindow = year >= startYear

longSignal = ta.crossover(fast, slow) and (not useFilter or rsi < rsiLimit)
shortSignal = ta.crossunder(fast, slow) and (not useFilter or rsi > 100 - rsiLimit)

// Absolute exit levels are recorded at entry and stay fixed while in the
// trade. Before any entry they are `na`, so the tick offsets apply.
var float entryLow = na
var float entryHigh = na
if longSignal
    entryLow := low
if shortSignal
    entryHigh := high

longStop = entryLow - ta.atr(14)
shortStop = entryHigh + ta.atr(14)

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------
strategy.entry("Long", strategy.long, when = longSignal and inWindow)
strategy.entry("Short", strategy.short, qty = math.max(1, math.floor(strategy.equity / close / 20)), when = shortSignal and inWindow and allowShorts)

strategy.exit("Long Exit", "Long", profit = takeTicks, loss = stopTicks, stop = longStop, comment = "long exit")
strategy.exit("Short Exit", "Short", limit = na, profit = takeTicks, stop = shortStop, loss = stopTicks)

// Leave both positions on a sharp momentum reversal.
strategy.close("Long", when = ta.crossunder(rsi, 50) and ta.change(rsi, 3) < -15, comment = "momentum")
strategy.close("Short", ta.crossover(rsi, 50))
strategy.close_all(when = not inWindow)

// ---------------------------------------------------------------------------
// Visuals
// ---------------------------------------------------------------------------
plot(fast, "Fast", color = color.teal)
plot(slow, "Slow", color = color.red)
plot(strategy.position_size > 0 ? longStop : na, "Long Stop", color = color.red, style = plot.style_linebr, linewidth = 1)
plot(strategy.position_size < 0 ? shortStop : na, "Short Stop", color = color.teal, style = plot.style_linebr, linewidth = 1)
plotshape(longSignal, "Long Signal", shape.arrowup, location.belowbar, color = color.teal, transp = 20)
plotshape(shortSignal, "Short Signal", shape.arrowdown, location.abovebar, color = color.red, transp = 20)
bgcolor(strategy.position_size > 0 ? color.new(color.teal, 90) : strategy.position_size < 0 ? color.new(color.red, 90) : na)

// Trade statistics for the status line.
winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : na
plot(winRate, "Win Rate", display = display.data_window)

// ---------------------------------------------------------------------------
// Risk controls
// ---------------------------------------------------------------------------
maxDailyLossPct = input.float(3.0, "Maximum Daily Loss Percent")
maxConsecutiveLosses = input.int(4, "Maximum Losing Trades In A Row")
strategy.risk.max_intraday_loss(maxDailyLossPct, strategy.percent_of_equity)
strategy.risk.max_cons_loss_days(maxConsecutiveLosses)

// Count consecutive losing trades as they close.
var int lossStreak = 0
var int lastClosed = 0
if strategy.closedtrades > lastClosed
    lastClosed := strategy.closedtrades
    lastProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    lossStreak := lastProfit < 0 ? lossStreak + 1 : 0
    label.new(bar_index, high, lastProfit >= 0 ? "+" + str.tostring(lastProfit, "#.##") : str.tostring(lastProfit, "#.##"), style = label.style_label_down, color = lastProfit >= 0 ? color.teal : color.red, size = size.tiny)

// A losing streak closes everything and waits for a fresh signal.
strategy.close_all(lossStreak >= maxConsecutiveLosses, comment = "streak stop")

var table board = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast
    table.cell(board, 0, 0, "Net Profit", text_color = color.white, bgcolor = color.gray)
    table.cell(board, 1, 0, str.tostring(strategy.netprofit, "#.##"), text_color = strategy.netprofit >= 0 ? color.teal : color.red)
    table.cell(board, 0, 1, "Trades", text_color = color.white, bgcolor = color.gray)
    table.cell(board, 1, 1, str.tostring(strategy.closedtrades), text_color = color.white)
    table.cell(board, 0, 2, "Win Rate", text_color = color.white, bgcolor = color.gray)
    table.cell(board, 1, 2, na(winRate) ? "-" : str.tostring(winRate, "#.#") + "%", text_color = color.white)
    table.cell(board, 0, 3, "Loss Streak", text_color = color.white, bgcolor = color.gray)
    table.cell(board, 1, 3, str.tostring(lossStreak), text_color = lossStreak > 1 ? color.orange : color.white)
