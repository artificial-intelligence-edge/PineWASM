//@version=6
indicator("Sector Rotation Monitor", overlay = false, max_labels_count = 20)
// v5 spelled a multiplier of 1 without the number ("D", not "1D").
__v6_timeframePeriodV5() =>
    timeframe.multiplier != 1 ? timeframe.period : timeframe.isdaily ? "D" : timeframe.isweekly ? "W" : timeframe.ismonthly ? "M" : timeframe.isseconds ? "S" : timeframe.period

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------
benchSymbol = input.symbol("SPY", "Reference Symbol")
symA = input.symbol("XLK", "Sector A")
symB = input.symbol("XLE", "Sector B")
symC = input.symbol("XLV", "Sector C")
momLen = input.int(20, "Momentum Length")
compareTf = input.timeframe("W", "Comparison Timeframe")
showWeekly = input.bool(true, "Show Weekly Strength")

// ---------------------------------------------------------------------------
// Relative strength against the reference. Each ratio is computed in its own
// requested context.
// ---------------------------------------------------------------------------
bench = request.security(benchSymbol, timeframe.period, close)
relA = request.security(symA, timeframe.period, close) / bench
relB = request.security(symB, timeframe.period, close) / bench
relC = request.security(symC, timeframe.period, close) / bench

momA = ta.roc(relA, momLen)
momB = ta.roc(relB, momLen)
momC = ta.roc(relC, momLen)

// Weekly strength of the first sector, with a momentum filter evaluated in
// the weekly context.
__v6_1() =>
    __v6_2 = ta.rsi(close, 14) > 50
    close > open and __v6_2
weeklyUp = request.security(symA, compareTf, __v6_1())

// The strongest sector this bar.
leader = momA >= momB and momA >= momC ? "A" : momB >= momC ? "B" : "C"
leaderChanged = leader != leader[1]

// Only look up the leader's daily range when it changes. The wrapper takes
// the symbol as a parameter, so each call is a dynamic request.
dailyRange(simple string sym) =>
    request.security(sym, "D", high - low)

float leaderRange = na
if leaderChanged
    if leader == "A"
        leaderRange := dailyRange(symA)
    else if leader == "B"
        leaderRange := dailyRange(symB)
    else
        leaderRange := dailyRange(symC)

// ---------------------------------------------------------------------------
// Plots
// ---------------------------------------------------------------------------
plot(momA, "Sector A", color = #00897B, linewidth = 2)
plot(momB, "Sector B", color = color.orange, linewidth = 2)
plot(momC, "Sector C", color = color.purple, linewidth = 2)
hline(0, "Zero", color = color.gray, linestyle = hline.style_dashed)
bgcolor(showWeekly and weeklyUp ? color.new(#00897B, 92) : na)
plot(leaderRange, "Leader Range", display = display.data_window)

if leaderChanged and barstate.isconfirmed
    label.new(bar_index, math.max(momA, momB, momC), "Leader " + leader, style = label.style_label_down, color = color.gray, size = size.small, textcolor = color.black)

var table t = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "Timeframe", text_color = color.white, bgcolor = color.gray)
    table.cell(t, 1, 0, __v6_timeframePeriodV5(), text_color = color.white, bgcolor = color.gray)
    table.cell(t, 0, 1, "A", text_color = color.white, bgcolor = leader == "A" ? #00897B : color.gray)
    table.cell(t, 1, 1, str.tostring(momA, "#.##"), text_color = color.white)
    table.cell(t, 0, 2, "B", text_color = color.white, bgcolor = leader == "B" ? #00897B : color.gray)
    table.cell(t, 1, 2, str.tostring(momB, "#.##"), text_color = color.white)
    table.cell(t, 0, 3, "C", text_color = color.white, bgcolor = leader == "C" ? #00897B : color.gray)
    table.cell(t, 1, 3, str.tostring(momC, "#.##"), text_color = color.white)

// ---------------------------------------------------------------------------
// Rotation history: the leader on each of the last few changes
// ---------------------------------------------------------------------------
historyLen = input.int(5, "Rotation History", minval = 1, maxval = 10)
var string[] history = array.new_string(0)
if leaderChanged
    array.unshift(history, leader)
    if array.size(history) > historyLen
        array.pop(history)

// How many of the recorded rotations went to each sector.
countOf(string s) =>
    n = 0
    for i = 0 to array.size(history) - 1 by 1
        if array.get(history, i) == s
            n := n + 1
            n
    n

// Breadth: how many sectors beat the reference over the momentum window.
breadth = (momA > 0 ? 1 : 0) + (momB > 0 ? 1 : 0) + (momC > 0 ? 1 : 0)
plot(breadth, "Breadth", color = color.gray, style = plot.style_stepline, display = display.data_window)
bgcolor(breadth == 0 ? color.new(#FF5252, 90) : na)

var table ht = table.new(position.bottom_right, 3, 1, border_width = 1)
if barstate.islast and array.size(history) > 0
    table.cell(ht, 0, 0, "A " + str.tostring(countOf("A")), text_color = color.white, bgcolor = #00897B)
    table.cell(ht, 1, 0, "B " + str.tostring(countOf("B")), text_color = color.white, bgcolor = color.orange)
    table.cell(ht, 2, 0, "C " + str.tostring(countOf("C")), text_color = color.white, bgcolor = color.purple)
