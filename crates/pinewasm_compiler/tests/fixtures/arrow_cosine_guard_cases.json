{
  "kind": "arrow-cosine-and-mixed-dependency-cases",
  "scope": "Regression expectations for PineWASM's compiler and runtime.",
  "arrows": [
    {
      "id": "unknown-const-left-and-series",
      "source": "//@version=6\nindicator(\"Arrow mixed dependency coverage\")\ncolor C=color.new(#336699,70)\nif math.cos(0) > 0 and close > 0\n    C:=#669933\nplotarrow(close,colorup=C)\n",
      "sourceSha256": "a8782bf3de984fd1d6e0c623d0a370f291a6d0020c42ce383eef821378e1ea2d",
      "expectedBindings": {
        "up": true,
        "down": false
      },
      "expectedStatic": {
        "up": {
          "r": 0,
          "g": 255,
          "b": 0,
          "t": 0
        },
        "down": {
          "r": 255,
          "g": 0,
          "b": 0,
          "t": 0
        }
      },
      "expectedStaticCss": {
        "up": "#00FF00",
        "down": "#FF0000"
      },
      "expectedCompileSuccess": true
    },
