{
  "schemaVersion": 1,
  "scope": "Regression expectations for PineWASM's own compiler and runtime.",
  "cases": [
    {
      "id": "series-cast-history",
      "source": "//@version=6\nindicator(\"arrow history rule\")\nseries color c=#336699\nplotarrow(close,colorup=color(c)[1],colordown=#993366)\n",
      "sourceSha256": "233eed2be83fb472987ae6bca37af610a3882b0c1ec8e2e2c41b6b8b5d26f785",
      "expectedUpColorer": true,
      "expected": {
        "up": {
          "origin": "dynamic",
          "r": 0,
          "g": 255,
          "b": 0,
          "t": 0
        },
        "down": {
          "origin": "constant",
          "r": 153,
          "g": 51,
          "b": 102,
          "t": 0
        }
      },
      "expectedCss": {
        "colordown": "#993366",
        "colorup": "#00FF00",
        "display": 4294967295
      },
      "expectedCsilSha256": "80967fd47b142454fc488c0bbe7df3158bda674475e36138c95f4b0111b3a588",
      "expectedCompileSuccess": true
    },
