{
  "kind": "helper-callsite-metadata-cases",
  "scope": "Regression expectations for PineWASM's own compiler and runtime.",
  "arrows": [
    {
      "id": "false-and-persistent",
      "source": "//@version=6\nindicator(\"helper Boolean origins\")\npick(bool flag)=>(false and flag)?#336699:#669933\nvar bool FLAG=true\nplotarrow(close,colorup=pick(FLAG),colordown=#993366)\nFLAG:=false\n",
      "sourceSha256": "0d1ea180b07ed239bf123a170df3f2e8d03cd5fc5915c615d8833c462aef074e",
      "expectedPlots": [
        {
          "bindings": {
            "up": true,
            "down": false
          },
          "static": {
            "up": {
              "r": 0,
              "g": 255,
              "b": 0,
              "t": 0
            },
            "down": {
              "r": 153,
              "g": 51,
              "b": 102,
              "t": 0
            }
          },
          "plotId": "plot_0"
        }
      ],
      "expectedCompileSuccess": true
    },
