{
  "schemaVersion": 1,
  "scope": "Regression expectations for PineWASM's own compiler and runtime.",
  "cases": [
    {
      "id": "nested-constant-false-under-dynamic",
      "source": "//@version=6\nindicator(\"guard rule\")\ncolor UP=color.new(#336699,70)\nif bar_index > 0\n    if math.sin(0) < 0\n        UP := color.new(#336699,70)\nplotarrow(bar_index%2==0?1:-1,colorup=UP,colordown=#993366)\n",
      "sourceSha256": "4494a101a00a03840db2a75c0c665d8b211b4288c2d9c77df3983713a46d84ef",
      "expected": {
        "runtimeColorers": {
          "up": false,
          "down": false
        },
        "staticColors": {
          "up": {
            "r": 51,
            "g": 102,
            "b": 153,
            "t": 70
          },
          "down": {
            "r": 153,
            "g": 51,
            "b": 102,
            "t": 0
          }
        },
        "staticCss": {
          "up": "rgba(51,102,153,0.3)",
          "down": "#993366"
        }
      },
      "expectedCompileSuccess": true
    },
    {
      "id": "nested-constant-true-under-dynamic",
      "source": "//@version=6\nindicator(\"guard rule\")\ncolor UP=color.new(#336699,70)\nif bar_index > 0\n    if math.sin(0) == 0\n        UP := color.new(#336699,70)\nplotarrow(bar_index%2==0?1:-1,colorup=UP,colordown=#993366)\n",
      "sourceSha256": "e712966d16b35f21236665322e609f8218a7f3467666470c91840a847e93977b",
      "expected": {
        "runtimeColorers": {
          "up": true,
          "down": false
        },
        "staticColors": {
          "up": {
            "r": 0,
            "g": 255,
            "b": 0,
            "t": 0
          },
          "down": {
            "r": 153,
