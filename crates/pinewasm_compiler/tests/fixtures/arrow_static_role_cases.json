  "cases": [
    {
      "id": "dynamic-two-arrows",
      "source": "//@version=6\nindicator(\"dynamic arrow static defaults\")\nplotarrow(close,title=\"Dynamic null\",colorup=bar_index==1 ? na : #336699,colordown=#993366)\nplotarrow(close,title=\"Dynamic alpha\",colorup=bar_index==1 ? color.new(#336699,70) : color.new(#336699,20),colordown=color.new(#993366,40))",
      "sourceSha256": "d5962649c151b490364b5eb4828d0368fae7aaf74f3196b4033eb87622525604",
      "expected": [
        {
          "up": {
            "origin": "dynamic",
            "r": 0,
            "g": 255,
            "b": 0,
            "t": 0
          },
          "down": {
            "origin": "constant",
            "r": 153,
            "g": 51,
            "b": 102,
            "t": 0
          }
        },
        {
          "up": {
            "origin": "dynamic",
            "r": 0,
            "g": 255,
            "b": 0,
            "t": 0
          },
          "down": {
            "origin": "constant",
            "r": 153,
            "g": 51,
            "b": 102,
            "t": 40
          }
        }
      ],
      "expectedCompileSuccess": true
    },
