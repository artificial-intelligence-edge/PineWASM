{
  "schemaVersion": 1,
  "scope": "Regression expectations for PineWASM's compiler and runtime.",
  "cases": [
    {
      "id": "math-abs-true",
      "source": "//@version=6\nindicator(\"constant guard math-abs-true\")\ncolor UP=color.new(#336699,70)\nif math.abs(-1)>0\n    UP:=color.new(#336699,70)\nplotarrow(close-close[1],colorup=UP,colordown=#993366)",
      "sourceSha256": "f144d1cfa4217b317216118e2409ee28d8a4fe80303439c0e9f72c77f2ccd98e",
      "expected": {
        "runtimeColorers": {
          "up": false,
          "down": false
        },
        "staticColors": {
          "up": {
            "r": 51,
            "g": 102,
            "b": 153,
            "t": 70
          },
          "down": {
            "r": 153,
            "g": 51,
            "b": 102,
            "t": 0
          }
        },
        "staticCss": {
          "up": "rgba(51,102,153,0.3)",
          "down": "#993366"
        }
      },
      "expectedCompileSuccess": true
    },
    {
