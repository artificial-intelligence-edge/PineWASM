{
  "kind": "arrow-boolean-and-literal-string-default-cases",
  "scope": "Regression expectations for PineWASM's compiler and runtime.",
  "arrows": [
    {
      "id": "guard/false and close > 0",
      "source": "//@version=6\nindicator(\"Arrow guard review\")\ncolor UP=color.new(#336699,70)\nif false and close > 0\n    UP:=#669933\nplotarrow(close,colorup=UP)\n",
      "sourceSha256": "67775ad4943b6603e20e6ef76d7afe05ab5ae43180fd08aa38bfbc27e6f9c7ba",
      "expectedBindings": {
        "up": false,
        "down": false
      },
      "expectedStatic": {
        "up": {
          "r": 51,
          "g": 102,
          "b": 153,
          "t": 70.0
        },
        "down": {
          "r": 255,
          "g": 0,
          "b": 0,
          "t": 0
        }
      },
      "expectedStaticCss": {
        "up": "rgba(51,102,153,0.3)",
        "down": "#FF0000"
      },
      "expectedCompileSuccess": true
    },
