{
  "schema_version": 1,
  "suite": "node-indicators-v1",
  "status": "exploratory-not-accepted",
  "host": "Node.js v22.22.3, one fresh local process per sample",
  "projection": "All named numeric plot values and titles, full history and na placement; no visual styling, drawings, realtime, or strategy equivalence claim",
  "input_generator": "First-party sine/cosine drift from 2020-01-01 UTC; generated in Rust and materialized once for every engine",
  "bars": [
    2000,
    10000
  ],
  "workloads": [
    "history",
    "arithmetic",
    "sma",
    "control",
    "persistent",
    "collections",
    "legacy-mixed"
  ],
