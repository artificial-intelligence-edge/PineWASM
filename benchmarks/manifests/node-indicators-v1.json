    "legacy-mixed"
  ],
  "engines": [
    "pinewasm",
    "pinets",
    "piner-js",
    "piner-interp",
    "resin",
    "pine-a-script",
    "openpine"
  ],
  "lanes": [
    "cold-runtime",
    "cached"
  ],
  "unavailable_lanes": {
    "openpine": [
      "cached"
    ]
  },
  "samples": 30,
  "warmups": {
    "cold-runtime": 0,
    "cached": 10
  },
  "iterations": 1,
  "timeout_seconds": 60,
  "order_seed": 20260905,
  "bootstrap_seed": 902883,
  "bootstrap_resamples": 10000,
  "absolute_tolerance": 1e-09,
  "relative_tolerance": 1e-10,
  "precision_floor_ms": 0.1,
  "packages": {
    "pinets": "0.9.33",
    "@heyphat/piner": "0.13.0",
    "@nullarch/resin": "0.2.2"
  },
