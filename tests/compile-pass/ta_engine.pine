//@version=6
indicator("TA engine batch")
plot(ta.ema(close, 3))
plot(ta.rsi(close, 2))
plot(ta.atr(2))
plot(ta.tr(true))
plot(math.sum(close, 2))
plot(fixnan(close))
plot(ta.vwma(close, 2))
plot(ta.alma(close, 3, 0.85, 6))
plot(ta.crossover(close, open) ? 1 : 0)
plot(ta.barssince(close > open))
plot(ta.valuewhen(close > open, close, 0))
plot(ta.linreg(close, 3, 0))
plot(ta.highest(close, 2) - ta.lowest(close, 2))
