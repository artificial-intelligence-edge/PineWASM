//@version=6
indicator("Math builtins")
a = math.abs(close - open)
b = math.sign(close - open)
c = math.sqrt(math.pow(close, 2))
d = math.round(close)
e = math.round(close, 2)
f = math.min(open, high, low, close)
g = math.max(1, 2, 3)
h = math.avg(high, low)
i = math.floor(close) + math.ceil(close)
j = math.log(math.exp(1)) + math.log10(10.0)
k = math.sin(0) + math.cos(0) + math.tan(0)
l = math.asin(1) + math.acos(1) + math.atan(1)
m = math.todegrees(math.toradians(90.0))
n = math.round_to_mintick(close)
r = math.random(0, 1, 7)
p = math.pi + math.e + math.phi + math.rphi
plot(a)
plot(b)
plot(c)
plot(d)
plot(e)
plot(f)
plot(g)
plot(h)
plot(i)
plot(j)
plot(k)
plot(l)
plot(m)
plot(n)
plot(r)
plot(p)
