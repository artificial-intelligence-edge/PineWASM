//@version=6
indicator("Loops")

// A counted `for` loop: sum 1..=5 into a persistent accumulator, reset each
// bar. The counter `i` is loop-local and immutable.
var total = 0
total := 0
for i = 1 to 5
    total := total + i
plot(total, "1..5 sum")

// A positive explicit step follows the descending direction of the bounds.
var down = 0
down := 0
for j = 10 to 2 by 2
    down := down + j
plot(down, "even 10..2 sum")

// Nested loops with `break` (innermost only) and `continue`.
var grid = 0
grid := 0
for a = 1 to 3
    for b = 1 to 3
        if b == 2
            continue
        grid := grid + 1
        if a == 3
            break
plot(grid, "grid count")

// A `while` loop with `:=` that terminates on its condition.
var w = 0
w := 0
while w < 4
    w := w + 1
plot(w, "while count")

// A `for` over float bounds types the counter as float.
var fsum = 0.0
fsum := 0.0
for x = 0.0 to 1.0 by 0.25
    fsum := fsum + x
plot(fsum, "float bound sum")
